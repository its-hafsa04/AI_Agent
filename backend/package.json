{
  "name": "appointment-chatbot-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "6.17.1",
    "bcrypt": "^6.0.0",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "latest",
    "@types/supertest": "^7.2.1",
    "eslint": "latest",
    "globals": "latest",
    "prettier": "latest",
    "prisma": "6.17.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  }
}
